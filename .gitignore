# Full-resolution source PNGs for the flying-dungeon tray frames.
# Only the compressed .webp frames are committed; these originals are huge
# (~300MB) and kept locally / regenerated via cwebp.
assets-v2/flying-dungeon/originals/

# Flying Dungeon itch.io build artifacts (regenerated by flying-dungeon/package.sh)
flying-dungeon/dist/
flying-dungeon/flying-dungeon-itch.zip

# Beat 'em up itch.io build artifacts (regenerated by beatemup-dungeon/package.sh).
# Both are pure output: dist/ is a COPY of src/ plus the assets the manifest
# names, and the zip is just that folder compressed. Nothing in either is
# authored, so committing them stores the whole asset set a second time and
# churns ~4MB on every build.
beatemup-dungeon/dist/
beatemup-dungeon/beatemup-dungeon-itch.zip
